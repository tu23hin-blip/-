# このファイルをコピーして .env を作り、値を入れてください（.env はgit管理外）
#   cp .env.example .env

# Claude（claude -p を API キーで動かす場合のみ。Claude Code にログイン済みなら空でOK）
ANTHROPIC_API_KEY=

# SQLite の場所（空なら engine/db/ai-company.db）
DB_PATH=

# 1日のAPIコスト上限（円）。超えたら全事業部を paused にする（フェーズ6）
DAILY_API_COST_LIMIT_JPY=

# 為替レート（API料金のUSD→円換算用。空なら 1ドル=150円で概算し、その旨をイベントに記録）
USD_JPY_RATE=

# 使うモデル（空なら Claude Code の既定）
CLAUDE_MODEL=

# claude -p のタイムアウト（ミリ秒。空なら15分）
CLAUDE_TIMEOUT_MS=

# X API（投稿の数字の自動取り込み。npm run metrics:x / 毎朝6時）
# アカウントごとに別の開発者アプリのキーを使う。どのキーをどの部門に使うかは engine/integrations/x-accounts.yaml
# 4つのうち1つでも空のアカウントは、何もせずスキップする
X_MAIN_API_KEY=
X_MAIN_API_SECRET=
X_MAIN_ACCESS_TOKEN=
X_MAIN_ACCESS_TOKEN_SECRET=
X_SUB_API_KEY=
X_SUB_API_SECRET=
X_SUB_ACCESS_TOKEN=
X_SUB_ACCESS_TOKEN_SECRET=
# 何日前までの投稿を読むか（インプレッションは2〜3日でほぼ伸びきる。増やすと読む件数＝費用が増える）
X_FETCH_DAYS=3

# タイムゾーン（スケジューラ用）
TZ=Asia/Tokyo
