{
  "name": "ai-company",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm install && npm --prefix web install && npm run db:init",
    "db:init": "node --disable-warning=ExperimentalWarning engine/db/init.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning engine/db/migrate-cli.js",
    "db:seed": "node --disable-warning=ExperimentalWarning engine/db/seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning engine/db/reset.js",
    "metrics:import": "node --disable-warning=ExperimentalWarning engine/db/import-csv.js",
    "voice:build": "node --disable-warning=ExperimentalWarning engine/cli/run.js materials voice",
    "research:x": "node --disable-warning=ExperimentalWarning engine/cli/run.js materials research",
    "metrics:x": "node --disable-warning=ExperimentalWarning engine/cli/run.js metrics x",
    "division": "node --disable-warning=ExperimentalWarning engine/cli/run.js",
    "analyst": "node --disable-warning=ExperimentalWarning engine/cli/run.js analyst weekly",
    "analyst:midweek": "node --disable-warning=ExperimentalWarning engine/cli/run.js analyst midweek",
    "scheduler": "node --disable-warning=ExperimentalWarning engine/scheduler/scheduler.js",
    "scheduler:list": "node --disable-warning=ExperimentalWarning engine/scheduler/scheduler.js --list",
    "status": "node --disable-warning=ExperimentalWarning engine/cli/status.js list",
    "new-division": "node --disable-warning=ExperimentalWarning engine/cli/new-division.js",
    "pause": "node --disable-warning=ExperimentalWarning engine/cli/status.js pause",
    "resume": "node --disable-warning=ExperimentalWarning engine/cli/status.js resume",
    "pause-all": "node --disable-warning=ExperimentalWarning engine/cli/status.js pause-all",
    "resume-all": "node --disable-warning=ExperimentalWarning engine/cli/status.js resume-all",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "test": "node --disable-warning=ExperimentalWarning --test 'engine/test/*.test.js'"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
