# 秘密情報
.env
.env.*
!.env.example

# 成果物（下書き）はgit管理しない。フォルダだけ残す
outputs/*
!outputs/.gitkeep

# 週次レポート（売上などの数字を含むためgit管理しない）
knowledge/reports/*
!knowledge/reports/.gitkeep

# 実行中ロック
engine/scheduler/locks/

# SQLite データベース本体
engine/db/*.db
engine/db/*.db-journal
engine/db/*.db-wal
engine/db/*.db-shm

# Node / Next.js
node_modules/
web/.next/
web/out/
*.log
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/

# OS / エディタ
.DS_Store
.vscode/
.idea/
engine/scheduler/scheduler.log
