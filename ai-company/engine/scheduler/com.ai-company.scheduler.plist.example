<?xml version="1.0" encoding="UTF-8"?>
<!-- Mac でログイン時にスケジューラを自動起動する設定（launchd）。
     使い方は README の「Mac で常駐させる」を参照。/Users/YOU/ai-company と node のパスを自分の環境に置き換える。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ai-company.scheduler</string>
  <key>WorkingDirectory</key><string>/Users/YOU/ai-company</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>engine/scheduler/scheduler.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- claude コマンドの場所を含める（which claude で確認） -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/ai-company/engine/scheduler/scheduler.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/ai-company/engine/scheduler/scheduler.log</string>
</dict>
</plist>
