# AI編集部の設定。このファイルを .env という名前でコピーして、値を書き換えてください。
# （.env は Git に登録されません。APIキーは .env にだけ書いてください）

# ── 使うAI ───────────────────────────────────────
# anthropic（Claude）/ openai / mock（APIを使わないお試し）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 役ごとにモデルを変える場合（任意）。例：LLM_MODEL_X_CONVERTER=claude-sonnet-5
# 役の名前：GENRE_SCOUT / EDITOR_IN_CHIEF / RESEARCHER / OUTLINER / WRITER / DIAGRAMMER / EYECATCH / REVIEWER / X_CONVERTER / X_PLANNER / ANALYST
# LLM_MODEL_WRITER=

# 考える深さ（Anthropic のみ・任意）：low / medium / high / xhigh / max。空欄ならモデルの標準
LLM_EFFORT=
# Claude が安全上の理由で断った場合に、推奨モデルで自動的にやり直す（空欄にすると無効）
LLM_REFUSAL_FALLBACK=default

# ── 費用 ──────────────────────────────────────────
# 1回の実行（記事1本）の上限（米ドル）。超えそうになったら止まります。
# Claude Opus 5 の概算（多めの見積もり）：通常 約3.3ドル／書き直し2回で最大 約6.7ドル
COST_LIMIT_PER_RUN=7
# ログに円で表示するときのレート
USD_JPY=150
# 単価表にないモデルを使うときの単価（米ドル / 100万トークン）
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# ── Web検索（リサーチャーと校閲だけが使います） ─────────
WEB_SEARCH_MAX_USES=5
# 1,000回あたりの料金（米ドル）
WEB_SEARCH_PRICE_PER_1K=10

# ── アイキャッチの背景画像（任意） ───────────────────
# 空欄なら背景画像は作りません（文字はいつもテンプレートで描きます）。今は openai のみ対応
IMAGE_API_PROVIDER=
IMAGE_MODEL=gpt-image-1
# 1枚あたりの料金の目安（米ドル）
IMAGE_PRICE_PER_IMAGE=0.08

# ── X投稿のスケジュール ───────────────────────────
X_POSTS_PER_DAY=3
X_POST_TIMES=07:30,12:15,21:00
# noteを公開する推奨時刻（X投稿の開始日）
NOTE_PUBLISH_TIME=07:00
TIMEZONE=Asia/Tokyo

# ── トレンド（任意） ──────────────────────────────
# RSSのURL（カンマ区切り）。例：Googleニュースの検索結果RSS
TREND_FEEDS=https://news.google.com/rss/search?q=%E7%94%9F%E6%88%90AI&hl=ja&gl=JP&ceid=JP:ja

# ── ダッシュボード ─────────────────────────────────
# 「投稿待ち」はこのPCからだけ見られます。スマホや別のPCから見る場合だけ 1 にしてください（同じWi-Fiの人も見られるようになります）
DASHBOARD_ALLOW_REMOTE=

# ── 画像の書き出し ───────────────────────────────
# Chromium の場所（通常は空欄。npx playwright install chromium でインストールしたものを使います）
CHROMIUM_PATH=
