# ---------- 基本 ----------
NODE_ENV=development
PORT=8787
BASE_URL=http://localhost:8787
TZ=Asia/Tokyo
DATABASE_PATH=./var/asp.db
STORAGE_DIR=./var/storage
LOG_LEVEL=info

# 認証（管理者ブートストラップ用APIキー）
BOOTSTRAP_API_KEY=changeme-bootstrap-key

# ---------- 生成AI（テキスト） ----------
# MOCKのままなら外部通信なしで全パイプラインが最後まで動く
LLM_PROVIDER=mock            # mock | openai | anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5

# ---------- 生成AI（動画） ----------
VIDEO_PROVIDER=mock          # mock | sora | seedance | astora
SORA_API_KEY=
SORA_BASE_URL=https://api.openai.com/v1
SORA_MODEL=sora-2
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-0-pro
ASTORA_API_KEY=
ASTORA_BASE_URL=
ASTORA_MODEL=astora-v1

# ---------- 生成AI（画像 / 音声） ----------
IMAGE_PROVIDER=mock          # mock | openai
IMAGE_MODEL=gpt-image-1
TTS_PROVIDER=mock            # mock | openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---------- 編集 ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_ENABLED=true          # false ならレンダリングコマンドの生成のみ（ドライラン）

# ---------- Meta 広告 ----------
META_ENABLED=false           # true で実APIへ。false ならサンドボックス(擬似)で運用ループが回る
META_API_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_DEFAULT_AD_ACCOUNT_ID=act_000000000000
META_DEFAULT_PAGE_ID=
META_DEFAULT_PIXEL_ID=

# ---------- 通知 / レポート配信 ----------
SLACK_WEBHOOK_URL=
REPORT_DELIVERY=store        # store | slack | email | webhook
REPORT_WEBHOOK_URL=
SMTP_URL=
REPORT_FROM=report@example.com
DAILY_REPORT_CRON_HOUR=9     # JST 何時に日次報告を生成するか

# ---------- 自社（請求書/契約書の発行元） ----------
COMPANY_NAME=株式会社サンプルメディア
COMPANY_ADDRESS=東京都渋谷区1-1-1
COMPANY_TEL=03-0000-0000
COMPANY_INVOICE_NO=T1234567890123
COMPANY_BANK=サンプル銀行 渋谷支店 普通 1234567 カ)サンプルメデイア
COMPANY_SEAL_TEXT=サンプル
